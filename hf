#!/usr/bin/env bash
# HyperFrames CLI (macOS/Linux). То же самое на любой системе: python3 hf.py … (Windows: python hf.py или hf.cmd)
#   ./hf check videos/<slug>/public
#   ./hf snapshot videos/<slug>/public --at 0,3,6 --describe false
#   ./hf render videos/<slug>/public -o videos/<slug>/output.mp4 --fps 25
exec python3 "$(cd "$(dirname "$0")" && pwd)/hf.py" "$@"
